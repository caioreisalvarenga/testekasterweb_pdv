            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"forma_pagamento\": \"pix\",\n  \"itens\": [\n    { \"produto_id\": 2, \"quantidade\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/vendas",
              "host": ["{{base_url}}"],
              "path": ["vendas"]
            },
            "description": "Cria uma venda com PIX (sem valor_recebido nem troco)."
          }
        },
