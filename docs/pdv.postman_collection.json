{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-0123-def4-567890123456",
    "name": "PDV - Teste Prático",
    "description": "Collection do PDV (Auth + Produtos + Vendas). Configure o environment com base_url=http://127.0.0.1:8000/api e faça login para popular o token automaticamente.\n\nCredenciais: teste@pdv.com / senha123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "produto_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "venda_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 200 && res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('Token salvo:', res.token);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna token', () => pm.expect(res.token).to.be.a('string'));",
                  "pm.test('Retorna user', () => pm.expect(res.user).to.be.an('object'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teste@pdv.com\",\n  \"password\": \"senha123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Login do operador. Salva o token automaticamente na variável de collection."
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna email', () => pm.expect(pm.response.json().email).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": ["{{base_url}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/produtos",
              "host": ["{{base_url}}"],
              "path": ["produtos"]
            }
          }
        },
        {
          "name": "Buscar por nome/código",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/produtos?busca=coca",
              "host": ["{{base_url}}"],
              "path": ["produtos"],
              "query": [{ "key": "busca", "value": "coca" }]
            }
          }
        },
        {
          "name": "Listar só disponíveis",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/produtos?disponiveis=1",
              "host": ["{{base_url}}"],
              "path": ["produtos"],
              "query": [{ "key": "disponiveis", "value": "1" }]
            }
          }
        },
        {
          "name": "Ver um",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": ["{{base_url}}"],
              "path": ["produtos", "{{produto_id}}"]
            }
          }
        },
        {
          "name": "Criar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('produto_id', res.id);",
                  "    console.log('produto_id salvo:', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Refrigerante Guaraná\",\n  \"codigo\": \"REF003\",\n  \"preco\": 5.75,\n  \"disponivel\": true,\n  \"estoque\": 30\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/produtos",
              "host": ["{{base_url}}"],
              "path": ["produtos"]
            }
          }
        },
        {
          "name": "Editar",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Guaraná Antarctica 350ml\",\n  \"codigo\": \"REF003\",\n  \"preco\": 6.00,\n  \"disponivel\": true,\n  \"estoque\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": ["{{base_url}}"],
              "path": ["produtos", "{{produto_id}}"]
            }
          }
        },
        {
          "name": "Excluir",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": ["{{base_url}}"],
              "path": ["produtos", "{{produto_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Vendas",
      "item": [
        {
          "name": "Criar venda - dinheiro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('venda_id', res.id);",
                  "    console.log('venda_id salvo:', res.id);",
                  "}",
                  "pm.test('Tem troco', () => pm.expect(res.troco).to.not.be.null);",
                  "pm.test('Status finalizada', () => pm.expect(res.status).to.eql('finalizada'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"forma_pagamento\": \"dinheiro\",\n  \"valor_recebido\": 50.00,\n  \"itens\": [\n    { \"produto_id\": 1, \"quantidade\": 2 },\n    { \"produto_id\": 5, \"quantidade\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/vendas",
              "host": ["{{base_url}}"],
              "path": ["vendas"]
            },
            "description": "Cria uma venda com pagamento em dinheiro. Calcula troco automaticamente no backend."
          }
        },
        {
          "name": "Criar venda - pix",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
